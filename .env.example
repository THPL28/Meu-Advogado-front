# Backend API base URL. Keep empty when the API is served by the same origin.
VITE_API_URL=""

# Production authentication uses HttpOnly cookies issued by the backend.
VITE_COOKIE_SESSION_ENABLED="true"

# Provider/business capabilities. Enable only after the corresponding backend integration is ready.
VITE_STRIPE_ENABLED="false"
VITE_PAYPAL_ENABLED="false"
VITE_ESCROW_ENABLED="false"
VITE_AUTO_RELEASE_ENABLED="false"

# Server-side Gemini key. NEVER expose this as VITE_GEMINI_API_KEY.
GEMINI_API_KEY=""

# Public application URL, when required by the backend/OAuth configuration.
APP_URL=""
